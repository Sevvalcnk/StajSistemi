@model IEnumerable<StajSistemi.Models.InternshipApplication>

@{
    ViewData["Title"] = "Mezuniyet Tescil Merkezi";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    @* --- 🎓 ÜST BİLGİ KARTI --- *@
    <div class="row mb-4 animate__animated animate__fadeIn">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h3 class="fw-bold mb-1">🎓 Mezuniyet Onay Merkezi</h3>
                        <p class="mb-0 opacity-75">Danışman mühürü almış liyakatli dosyaları resmi olarak tescil edin ve sertifika mailini uçurun.</p>
                    </div>
                    <div class="d-none d-md-block">
                        <i class="fas fa-user-graduate fa-4x opacity-25"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- 🛡️ MEZUNİYET LİSTESİ --- *@
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden animate__animated animate__fadeInUp">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-list-ul me-2 text-primary"></i> Onay Bekleyen Kuyruk</h5>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">@Model.Count() Dosya Mevcut</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 text-uppercase small fw-bold text-muted">Öğrenci Bilgileri</th>
                            <th class="text-uppercase small fw-bold text-muted">Staj Yapılan Kurum</th>
                            <th class="text-uppercase small fw-bold text-muted">Hoca Onay Tarihi</th>
                            <th class="text-center text-uppercase small fw-bold text-muted">Eylemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fas fa-inbox fa-3x mb-3 opacity-25"></i>
                                        <p class="h5 fw-bold mb-0">Kuyruk Şu An Boş!</p>
                                        <small>Mezuniyet tescili bekleyen bir dosya bulunmuyor.</small>
                                    </div>
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width:45px; height:45px; font-weight:bold;">
                                            @item.AppUser?.FullName?.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark theme-text">@item.AppUser?.FullName</div>
                                            <small class="text-muted">@item.AppUser?.UserName</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark theme-text">@item.Internship?.CompanyName</div>
                                    <span class="badge bg-secondary-subtle text-secondary small">@item.Internship?.Name</span>
                                </td>
                                <td>
                                    <div class="text-muted small">
                                        <i class="far fa-calendar-check me-1"></i> @item.CompletedDate?.ToString("dd.MM.yyyy")
                                    </div>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group">
                                        <a href="/Advisor/ViewStudentFile?studentId=@item.AppUserId" class="btn btn-sm btn-outline-primary rounded-start-pill px-3 shadow-sm">
                                            <i class="fas fa-search me-1"></i> İNCELE
                                        </a>
                                        <button type="button" class="btn btn-sm btn-success rounded-end-pill px-4 fw-bold shadow-sm finalize-btn"
                                                data-id="@item.Id"
                                                data-name="@item.AppUser?.FullName">
                                            <i class="fas fa-graduation-cap me-1"></i> MEZUN ET
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* 🛡️ Anti-Forgery Token *@
@Html.AntiForgeryToken()

<style>
    /* 🌙 SİBER GECE UYUMU KORUNDU */
    html[data-theme="dark"] .card {
        background-color: #1e293b !important;
    }

    html[data-theme="dark"] .card-header {
        background-color: #1e293b !important;
        border-bottom: 1px solid #334155 !important;
    }

    html[data-theme="dark"] .table {
        color: #f1f5f9 !important;
    }

        html[data-theme="dark"] .table thead {
            background-color: #0f172a !important;
        }

    html[data-theme="dark"] .table-hover tbody tr:hover {
        background-color: rgba(255,255,255,0.05) !important;
    }

    html[data-theme="dark"] .theme-text {
        color: #f1f5f9 !important;
    }

    html[data-theme="dark"] .bg-light {
        background-color: #0f172a !important;
    }

    .avatar-sm {
        box-shadow: 0 4px 10px rgba(67, 97, 238, 0.3);
    }

    .table-responsive {
        min-height: 400px;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            $('.finalize-btn').on('click', function () {
                const appId = $(this).data('id');
                const studentName = $(this).data('name');
                const token = $('input[name="__RequestVerificationToken"]').val();

                Swal.fire({
                    title: '🎓 Mezuniyeti Tescil Et?',
                    html: `<b>${studentName}</b> isimli öğrenciyi mezun etmek istiyor musunuz?<br><small class="text-success mt-2">Özel Mezuniyet Belgesi mail ile anında gönderilecektir! ✨</small>`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#10b981',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Evet, Mezun Et!',
                    cancelButtonText: 'Vazgeç'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // 🚀 YÜKLENİYOR SİNYALİ
                        Swal.fire({
                            title: 'Tescil Ediliyor...',
                            text: 'Resmi sertifika üretiliyor, lütfen bekleyin.',
                            allowOutsideClick: false,
                            didOpen: () => { Swal.showLoading(); }
                        });

                        $.ajax({
                            url: '/Admin/FinalizeGraduation',
                            type: 'POST',
                            data: {
                                appId: appId,
                                __RequestVerificationToken: token
                            },
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire({
                                        title: '🏆 Başarıyla Tescillendi!',
                                        text: response.message,
                                        icon: 'success',
                                        timer: 3000,
                                        showConfirmButton: false
                                    }).then(() => {
                                        location.reload();
                                    });
                                } else {
                                    Swal.fire('Hata!', response.message, 'error');
                                }
                            },
                            error: function() {
                                Swal.fire('Hata!', 'Siber bir takılma yaşandı.', 'error');
                            }
                        });
                    }
                });
            });
        });
    </script>
}