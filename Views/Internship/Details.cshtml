@* --- 🗺️ GÜNCELLENMİŞ DÜZEN: İŞ TANIMI VE HARİTA YAN YANA --- *@
<div class="row g-4 mb-5">
    @* SOL TARAF: İŞ TANIMI *@
    <div class="col-md-7">
        <h5 class="fw-bold text-dark mb-3">
            <i class="fas fa-file-alt me-2 text-primary"></i>İş Tanımı ve Detaylar
        </h5>
        <div class="p-4 bg-light rounded-4 shadow-sm border-start border-4 border-primary h-100">
            <p class="text-secondary" style="line-height: 1.8;">@Model.Description</p>
        </div>
    </div>

    @* SAĞ TARAF: KONUM BİLGİSİ VE CANLI HARİTA *@
    <div class="col-md-5">
        <h5 class="fw-bold text-dark mb-3">
            <i class="fas fa-map-marked-alt me-2 text-danger"></i>Konum Bilgisi
        </h5>
        <div class="p-3 bg-light rounded-4 shadow-sm h-100 border">
            @* 📍 CANLI HARİTA MÜHRÜ - Link Yapısı Düzenlendi *@
            <div class="rounded-3 overflow-hidden shadow-sm mb-3" style="height: 250px;">
                <iframe width="100%"
                        height="100%"
                        style="border:0;"
                        loading="lazy"
                        allowfullscreen
                        src="https://maps.google.com/maps?q=@(Model.City?.Name ?? Model.CityName ?? "İstanbul")&t=&z=13&ie=UTF8&iwloc=&output=embed">
                </iframe>
            </div>
            <div class="text-center">
                <i class="fas fa-map-pin text-danger me-1"></i>
                <span class="fw-bold text-dark">@(Model.City?.Name ?? Model.CityName ?? "Belirtilmemiş")</span>
            </div>
        </div>
    </div>
</div>