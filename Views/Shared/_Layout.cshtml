@using Microsoft.AspNetCore.Identity
@using StajSistemi.Models
@using Microsoft.EntityFrameworkCore
@inject UserManager<AppUser> UserManager
@inject StajSistemi.data.ApplicationDbContext _context

<!DOCTYPE html>
<html lang="tr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - StajSistemi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --staj-bg: #f4f7f6;
            --staj-nav-bg: #ffffff;
            --staj-text: #333333;
            --staj-card-bg: #ffffff;
            --staj-border: #e3e6f0;
        }

        html[data-theme="dark"] {
            --staj-bg: #0f172a !important;
            --staj-nav-bg: #1e293b !important;
            --staj-text: #f1f5f9 !important;
            --staj-card-bg: #1e293b !important;
            --staj-border: rgba(255, 255, 255, 0.1) !important;
        }

        body {
            overflow-x: hidden;
            background-color: var(--staj-bg) !important;
            color: var(--staj-text) !important;
            font-family: 'Inter', sans-serif;
            transition: all 0.2s ease-in-out;
        }

        /* 🌙 SİBER BALYOZ: TÜM İNATÇI BEYAZ ALANLARI ZORLA KARARTMA */
        html[data-theme="dark"] .card,
        html[data-theme="dark"] .card-body,
        html[data-theme="dark"] .card-header,
        html[data-theme="dark"] .card-footer,
        html[data-theme="dark"] .bg-white,
        html[data-theme="dark"] .bg-light,
        html[data-theme="dark"] .navbar,
        html[data-theme="dark"] #page-content-wrapper,
        html[data-theme="dark"] .table,
        html[data-theme="dark"] .table td,
        html[data-theme="dark"] .table th,
        html[data-theme="dark"] .form-control,
        html[data-theme="dark"] .form-select,
        html[data-theme="dark"] .swal2-popup,
        html[data-theme="dark"] main {
            background-color: var(--staj-card-bg) !important;
            color: var(--staj-text) !important;
            border-color: var(--staj-border) !important;
        }

        /* 🚀 GECE MODU: OKUNABİLİRLİK VE YAZI PARLATMA MÜHÜRÜ */
        html[data-theme="dark"] .text-dark,
        html[data-theme="dark"] .text-muted,
        html[data-theme="dark"] .fw-bold.text-dark,
        html[data-theme="dark"] span:not(.badge),
        html[data-theme="dark"] small:not(.badge),
        html[data-theme="dark"] label,
        html[data-theme="dark"] p,
        html[data-theme="dark"] td {
            color: #f1f5f9 !important;
        }

        /* 🟢 KRİTİK: İNCELE SAYFASINDAKİ "ONAYLANDI" BEYAZLIĞINI İMHA ET */
        html[data-theme="dark"] .bg-success-subtle,
        html[data-theme="dark"] .alert-success,
        html[data-theme="dark"] [style*="background-color: #e8f5e9"],
        html[data-theme="dark"] div[style*="background-color: #e8f5e9"],
        html[data-theme="dark"] .rounded-4.p-4.mb-4 {
            background-color: rgba(16, 185, 129, 0.15) !important; /* Koyu yeşil şeffaf */
            color: #34d399 !important;
            border: 1px solid rgba(16, 185, 129, 0.3) !important;
        }

        /* 🏛️ SELECT2 VE DİĞER BEYAZ SIZINTILAR */
        html[data-theme="dark"] .select2-container--default .select2-selection--multiple,
        html[data-theme="dark"] .select2-dropdown,
        html[data-theme="dark"] .select2-search__field {
            background-color: #1e293b !important;
            color: #f1f5f9 !important;
            border-color: rgba(255,255,255,0.1) !important;
        }

        html[data-theme="dark"] .select2-selection__choice {
            background-color: #334155 !important;
            color: #f1f5f9 !important;
            border: 1px solid #475569 !important;
        }

        /* ✍️ EDİTÖR (SUMMERNOTE) KARARTMA MÜHÜRÜ */
        html[data-theme="dark"] .note-editor,
        html[data-theme="dark"] .note-editable {
            background-color: #0f172a !important;
            color: #f1f5f9 !important;
        }

        html[data-theme="dark"] .note-dropdown-menu {
            background-color: #1e293b !important;
            color: white !important;
            border: 1px solid #334155 !important;
        }

        html[data-theme="dark"] .note-btn {
            background-color: #334155 !important;
            color: white !important;
        }

        /* ⚠️ ALERT/BİLDİRİM BEYAZLIĞINI İMHA ET */
        html[data-theme="dark"] .alert {
            background-color: #1e293b !important;
            color: #f1f5f9 !important;
            border: 1px solid var(--staj-border) !important;
        }

        html[data-theme="dark"] .alert-warning {
            border-left: 5px solid #fbbf24 !important;
        }

        html[data-theme="dark"] .text-primary,
        html[data-theme="dark"] .fw-bold.text-primary {
            color: #60a5fa !important;
        }

        /* 📏 SİBER DÜZEN: RAKAM HİZALAMA */
        .badge, .status-badge {
            white-space: nowrap !important;
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
            min-width: 24px;
            padding: 4px 8px !important;
            font-weight: 700 !important;
            line-height: 1 !important;
            text-align: center;
        }

        #wrapper {
            display: flex;
            width: 100%;
            align-items: stretch;
        }

        #sidebar-wrapper {
            min-height: 100vh;
            width: 260px;
            background: #1e293b !important;
            color: white !important;
            position: fixed;
            left: 0;
            top: 0;
            z-index: 1050;
            transition: transform 0.3s ease;
        }

            #sidebar-wrapper .list-group-item {
                background-color: transparent !important;
                color: rgba(255,255,255,0.7) !important;
                border: none !important;
                padding: 1rem 1.5rem;
            }

                #sidebar-wrapper .list-group-item:hover, #sidebar-wrapper .list-group-item.active-link {
                    background-color: rgba(67, 97, 238, 0.2) !important;
                    color: white !important;
                }

        #page-content-wrapper {
            width: 100%;
            flex: 1;
            transition: all 0.3s ease;
            margin-left: 260px;
        }

        body.sb-sidenav-toggled #sidebar-wrapper {
            transform: translateX(-260px);
        }

        body.sb-sidenav-toggled #page-content-wrapper {
            margin-left: 0;
        }

        @@media (max-width: 768px) {
            #sidebar-wrapper {
                transform: translateX(-260px);
            }

            #page-content-wrapper {
                margin-left: 0;
            }

            body.sb-sidenav-toggled #sidebar-wrapper {
                transform: translateX(0);
            }
        }

        .navbar {
            background: var(--staj-nav-bg) !important;
            border-bottom: 1px solid var(--staj-border);
            padding: 0.8rem 1rem;
        }
    </style>
</head>
<body>
    @{
        var currentUserId = UserManager.GetUserId(User);
        int parsedUserId = currentUserId != null ? int.Parse(currentUserId) : 0;

        // 🛡️ SİBER FİLTRE: Sadece hocanın henüz bakmadığı, durumu 'Pending' olanları say.
        // Onaylanmış (Approved) olanlar artık bildirim sayısına dahil edilmez!
        var pendingAppsCount = _context.InternshipApplications.AsNoTracking()
        .Count(a => a.Status == ApplicationStatus.Pending && !a.IsDeleted);

        var unreadMessagesCount = _context.ChatMessages.AsNoTracking()
        .Count(m => m.ReceiverId == parsedUserId && !m.IsRead);
    }

    <div id="wrapper">
        <div id="sidebar-wrapper">
            <div class="sidebar-heading" style="padding: 1.5rem; font-weight: 800; border-bottom: 1px solid rgba(255,255,255,0.1); color:white;">
                <i class="fas fa-graduation-cap me-2 text-primary"></i>StajSistemi
            </div>
            <div class="list-group list-group-flush mt-3">
                <a asp-controller="Home" asp-action="Index" class="list-group-item list-group-item-action">
                    <i class="fas fa-home me-2 text-secondary"></i> Ana Sayfa
                </a>

                @if (User.Identity.IsAuthenticated)
                {
                    if (User.IsInRole("Advisor") || User.IsInRole("Admin"))
                    {
                        <a asp-controller="Advisor" asp-action="InternshipApplications" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-envelope-open-text me-2 text-warning"></i> Gelen Başvurular</span>
                            @if (pendingAppsCount > 0)
                            {
                                <span class="badge rounded-pill bg-danger animate__animated animate__pulse animate__infinite">@pendingAppsCount</span>
                            }
                        </a>

                        if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Admin" asp-action="GraduationQueue" class="list-group-item list-group-item-action">
                                <i class="fas fa-graduation-cap me-2 text-success"></i> Mezuniyet Onayları
                            </a>
                        }

                        <a asp-controller="Advisor" asp-action="Index" class="list-group-item list-group-item-action"><i class="fas fa-users me-2 text-danger"></i> Öğrenci Listesi</a>
                        <a asp-controller="Advisor" asp-action="Archive" class="list-group-item list-group-item-action"><i class="fas fa-archive me-2 text-secondary"></i> Başvuru Arşivi</a>

                        <a asp-controller="Chat" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-comments me-2 text-info"></i> Gelen Mesajlar</span>
                            @if (unreadMessagesCount > 0)
                            {
                                <span class="badge rounded-pill bg-primary">@unreadMessagesCount</span>
                            }
                        </a>
                    }

                    if (User.IsInRole("Student"))
                    {
                        <a asp-controller="StudentPanel" asp-action="Index" class="list-group-item list-group-item-action"><i class="fas fa-user-graduate me-2 text-primary"></i> Kariyer Panelim</a>
                        <a asp-controller="StudentPanel" asp-action="Applications" class="list-group-item list-group-item-action"><i class="fas fa-file-invoice me-2 text-warning"></i> Başvurularım</a>
                        <a asp-controller="StudentPanel" asp-action="Results" class="list-group-item list-group-item-action"><i class="fas fa-history me-2 text-success"></i> Başvuru Sonuçlarım</a>

                        <a asp-controller="Chat" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-comment-dots me-2 text-info"></i> Mesajlarım</span>
                            @if (unreadMessagesCount > 0)
                            {
                                <span class="badge rounded-pill bg-primary">@unreadMessagesCount</span>
                            }
                        </a>

                        bool isApproved = _context.InternshipApplications.Any(a => a.AppUserId == parsedUserId && a.Status == ApplicationStatus.Approved);
                        if (isApproved)
                        {
                            <a asp-controller="StudentPanel" asp-action="Documents" class="list-group-item list-group-item-action">
                                <i class="fas fa-file-signature me-2 text-primary"></i> <strong>Staj Defterim</strong>
                            </a>
                        }
                        else
                        {
                            <a href="javascript:void(0)" onclick="Swal.fire({ title: 'Erişim Kilitli! 🔒', text: 'Staj defterine erişmek için başvurunuzun onaylanması gerekir.', icon: 'info', confirmButtonColor: '#4361ee' })"
                               class="list-group-item list-group-item-action opacity-50">
                                <i class="fas fa-lock me-2 text-muted"></i> Staj Defteri
                            </a>
                        }
                    }
                    <div class="border-top my-2 opacity-25"></div>
                    <a asp-controller="Internship" asp-action="Index" class="list-group-item list-group-item-action"><i class="fas fa-search me-2 text-success"></i> Staj İlanları</a>
                }
            </div>
        </div>

        <div id="page-content-wrapper" class="d-flex flex-column">
            <nav class="navbar navbar-expand-lg navbar-light shadow-sm sticky-top">
                <div class="container-fluid">
                    <button class="btn btn-primary shadow-sm border-0" id="sidebarToggle" type="button"><i class="fas fa-bars"></i></button>
                    <div class="ms-auto d-flex align-items-center">
                        <button id="darkModeToggle" class="btn btn-link text-warning me-3 shadow-none border-0">
                            <i id="themeIcon" class="fas fa-moon fs-5"></i>
                        </button>
                        @if (User.Identity.IsAuthenticated)
                        {
                            var user = await UserManager.GetUserAsync(User);
                            <span class="me-3 d-none d-md-inline fw-bold theme-text">
                                <i class="fas fa-user-circle me-1 text-primary"></i> @(user?.FullName ?? User.Identity.Name)
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold">Çıkış</button>
                            </form>
                        }
                    </div>
                </div>
            </nav>
            <div class="container-fluid p-2 p-md-4">
                <main role="main" class="pb-3">@RenderBody()</main>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        const toggleBtn = document.getElementById('darkModeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const html = document.documentElement;
        const savedTheme = localStorage.getItem('staj-theme') || 'light';
        html.setAttribute('data-theme', savedTheme);
        if(savedTheme === 'dark') themeIcon.className = 'fas fa-sun fs-5';

        toggleBtn.addEventListener('click', () => {
            const currentTheme = html.getAttribute('data-theme');
            const newTheme = currentTheme === 'light' ? 'dark' : 'light';
            html.setAttribute('data-theme', newTheme);
            localStorage.setItem('staj-theme', newTheme);
            themeIcon.className = newTheme === 'dark' ? 'fas fa-sun fs-5' : 'fas fa-moon fs-5';
        });

        $("#sidebarToggle").on("click", function (e) {
            e.preventDefault();
            $("body").toggleClass("sb-sidenav-toggled");
        });
    </script>
</body>
</html>