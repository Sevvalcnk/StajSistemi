@using StajSistemi.Models
@model IEnumerable<StajSistemi.Models.InternshipApplication>

@{
    ViewData["Title"] = "Başvurularım";
}

@* 🎨 EK CSS: Tikli Mühürlerin Tasarımı *@
<style>
    .status-badge-wrapper {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 16px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.85rem;
        min-width: 130px;
        justify-content: center;
        transition: 0.3s;
    }

    /* Aydınlık Mod Renkleri */
    .status-approved {
        background-color: #dcfce7;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .status-rejected {
        background-color: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .status-pending {
        background-color: #fef3c7;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .status-inreview {
        background-color: #e0f2fe;
        color: #0369a1;
        border: 1px solid #bae6fd;
    }

    /* 🌙 GECE MODU UYUMU (SİBER NEON) */
    html[data-theme="dark"] .status-approved {
        background-color: rgba(16, 185, 129, 0.15) !important;
        color: #10b981 !important;
        border-color: rgba(16, 185, 129, 0.3) !important;
    }

    html[data-theme="dark"] .status-rejected {
        background-color: rgba(239, 68, 68, 0.15) !important;
        color: #ef4444 !important;
        border-color: rgba(239, 68, 68, 0.3) !important;
    }

    html[data-theme="dark"] .status-pending {
        background-color: rgba(245, 158, 11, 0.15) !important;
        color: #f59e0b !important;
        border-color: rgba(245, 158, 11, 0.3) !important;
    }

    html[data-theme="dark"] .status-inreview {
        background-color: rgba(14, 165, 233, 0.15) !important;
        color: #38bdf8 !important;
        border-color: rgba(14, 165, 233, 0.3) !important;
    }

    html[data-theme="dark"] .glass-card {
        background: #1e293b !important;
        border: 1px solid rgba(255,255,255,0.05) !important;
    }

    html[data-theme="dark"] .table {
        color: #f1f5f9 !important;
    }

        html[data-theme="dark"] .table tr:hover {
            background-color: rgba(255,255,255,0.02) !important;
        }
</style>

<div class="container py-4 techNode-fade-in">
    @* --- 🛡️ ÜST BAŞLIK VE ÖZET KARTI --- *@
    <div class="glass-card p-4 shadow-lg border-0 rounded-4 bg-white mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h4 class="fw-bold mb-1 text-dark">
                    <i class="fas fa-file-signature text-primary me-2"></i>Staj Başvurularım
                </h4>
                <p class="text-muted small mb-0">Yaptığınız tüm başvuruların güncel durumunu buradan profesyonelce takip edebilirsiniz.</p>
            </div>
            <span class="badge bg-soft-primary text-primary rounded-pill px-4 py-2 border fw-bold">
                <i class="fas fa-paper-plane me-1"></i> Toplam: @(Model?.Count() ?? 0) Başvuru
            </span>
        </div>
    </div>

    @* --- 📋 BAŞVURU TABLOSU --- *@
    <div class="glass-card shadow-lg border-0 rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-primary text-white">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase small fw-bold">Şirket / Kurum</th>
                        <th class="py-3 text-uppercase small fw-bold text-center">Bölüm</th>
                        <th class="py-3 text-uppercase small fw-bold text-center">Başarı Skoru</th>
                        <th class="py-3 text-uppercase small fw-bold text-center">Başvuru Durumu</th>
                        <th class="pe-4 py-3 text-uppercase small fw-bold text-end">Detaylar</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="fw-bold text-dark">@(item.Internship?.CompanyName ?? "Belirtilmemiş")</div>
                                    <small class="text-muted"><i class="fas fa-map-marker-alt me-1"></i> @(item.Internship?.City?.Name ?? "Konum Bilgisi Yok")</small>
                                </td>

                                @* ✅ SİBER DÜZELTME KORUNDU *@
                                <td class="py-3 text-center">
                                    @if (item.Internship?.InternshipDepartments != null && item.Internship.InternshipDepartments.Any())
                                    {
                                        @foreach (var deptMap in item.Internship.InternshipDepartments)
                                        {
                                            <span class="badge bg-light text-primary border border-primary rounded-pill small m-1">
                                                @(deptMap.Department?.DepartmentName ?? "Bölüm")
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Genel</span>
                                    }
                                </td>

                                @* ✅ KRİTİK MÜHÜR KORUNDU *@
                                <td class="py-3 text-center">
                                    @{
                                        double academicScore = item.SuccessScore > 0 ? (item.SuccessScore / 100.0) : (item.AppUser?.GPA ?? 0.0);
                                    }
                                    <div class="badge @(academicScore >= 3.0 ? "bg-success" : "bg-dark") text-white px-3 py-2 rounded-3 shadow-sm fw-bold">
                                        <i class="fas fa-graduation-cap me-1"></i> @academicScore.ToString("0.00")
                                    </div>
                                </td>

                                @* 🚀 136-137. RESİM GÜNCELLEMESİ: TİKLİ MÜHÜRLER *@
                                <td class="py-3 text-center">
                                    @if (item.Status == ApplicationStatus.Approved)
                                    {
                                        <div class="status-badge-wrapper status-approved">
                                            <i class="fas fa-check-circle"></i>
                                            <span>Onaylandı</span>
                                        </div>
                                    }
                                    else if (item.Status == ApplicationStatus.Rejected)
                                    {
                                        <div class="status-badge-wrapper status-rejected">
                                            <i class="fas fa-times-circle"></i>
                                            <span>Sonuçlandı</span>
                                        </div>
                                    }
                                    else if (item.Status == ApplicationStatus.InReview)
                                    {
                                        <div class="status-badge-wrapper status-inreview">
                                            <i class="fas fa-search"></i>
                                            <span>İnceleniyor</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="status-badge-wrapper status-pending">
                                            <i class="fas fa-clock"></i>
                                            <span>Beklemede</span>
                                        </div>
                                    }
                                </td>

                                <td class="pe-4 py-3 text-end">
                                    <a asp-action="Details" asp-route-id="@item.InternshipId"
                                       class="btn btn-outline-primary btn-sm rounded-pill px-4 transition hover-up fw-bold">
                                        <i class="fas fa-eye me-1"></i> İncele
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-5 text-center">
                                <div class="opacity-50">
                                    <i class="fas fa-folder-open fa-3x mb-3 text-muted"></i>
                                    <p class="mb-0 fw-bold">Henüz aktif bir staj başvurunuz bulunmamaktadır.</p>
                                    <small>Yeni kariyer fırsatlarını keşfetmeye ne dersiniz? 😊</small>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-soft-primary {
        background-color: rgba(67, 97, 238, 0.1);
    }

    .transition {
        transition: all 0.3s ease;
    }

    .hover-up:hover {
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.1) !important;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(67, 97, 238, 0.02);
    }
</style>