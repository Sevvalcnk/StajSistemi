@model StajSistemi.DTOs.StudentDto
@{
    Layout = "_Layout";
    var activeApp = ViewBag.ActiveInternship as StajSistemi.Models.InternshipApplication;
    var reports = ViewBag.DailyReports as List<StajSistemi.Models.DailyReport> ?? new List<StajSistemi.Models.DailyReport>();
    int totalDays = 30;
    bool isAdvisor = User.IsInRole("Advisor") || User.IsInRole("Admin");

    // 🛡️ 🚀 İL BAZLI SİBER LOGO EŞLEŞTİRME MOTORU
    string uniName = Model?.UniversityName?.ToLower() ?? "";
    string logoFileName = "default"; // Eşleşme olmazsa kep logosu

    // Klasöründeki dosya isimlerinin listesi
    string[] iller = { "ankara", "antalya", "aydin", "bursa", "eskisehir", "istanbul", "izmir", "kastamonu", "kocaeli", "mugla", "ordu", "sakarya", "samsun", "sinop", "trabzon" };

    foreach (var il in iller)
    {
        // Üniversite isminin içinde il ismi geçiyor mu?
        if (uniName.Contains(il) ||
           (il == "aydin" && uniName.Contains("aydın")) ||
           (il == "eskisehir" && uniName.Contains("eskişehir")))
        {
            logoFileName = il;
            break;
        }
    }

    // Özel Durum: Karadeniz Teknik gibi isimlerde şehir geçmiyorsa manuel mühürle
    if (uniName.Contains("karadeniz teknik")) { logoFileName = "trabzon"; }

    string logoPath = $"/img/logos/{logoFileName}.png";

    // Dinamik Birim Adı (Artık Ayancık sabit değil, Model'den geliyor)
    string birimAdi = Model?.FacultyName?.ToUpper() ?? "BİRİM BELİRTİLMEMİŞ";
}

<style>
    /* 💻 EKRAN TASARIMI */
    body {
        background-color: #f3f6f9;
        font-family: 'Inter', sans-serif;
        overflow-x: hidden;
    }

    /* 🌑 SİBER GECE MODU UYUMU */
    html[data-theme="dark"] body {
        background-color: #0f172a !important;
    }

    html[data-theme="dark"] .staj-nav-top, html[data-theme="dark"] .staj-sidebar .card, html[data-theme="dark"] .day-item {
        background-color: #1e293b !important;
        color: #f1f5f9 !important;
        border-color: rgba(255,255,255,0.1) !important;
    }

    html[data-theme="dark"] .official-document, html[data-theme="dark"] .document-content {
        background-color: #1e293b !important;
        color: #f1f5f9 !important;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5) !important;
    }

    html[data-theme="dark"] .official-table, html[data-theme="dark"] .official-table td {
        border-color: #475569 !important;
        color: #f1f5f9 !important;
    }

        html[data-theme="dark"] .official-table td:first-child {
            background-color: #334155 !important;
        }

    .staj-workspace {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 20px;
        width: 100%;
        min-height: 100vh;
    }

    .staj-nav-top {
        display: flex;
        gap: 10px;
        margin-bottom: 25px;
        background: #fff;
        padding: 10px 25px;
        border-radius: 50px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: 1px solid #e2e8f0;
        z-index: 1000;
    }

    .nav-btn {
        border: none;
        padding: 10px 30px;
        border-radius: 30px;
        font-weight: 700;
        transition: 0.3s;
        font-size: 14px;
        color: #64748b;
        background: transparent;
        cursor: pointer;
    }

        .nav-btn.active {
            background-color: #4361ee !important;
            color: white !important;
        }

    .staj-main-container {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 30px;
        width: 100%;
        max-width: 1400px;
    }

    .staj-sidebar {
        width: 300px;
        flex-shrink: 0;
    }

    .day-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 10px;
    }

    .day-item {
        aspect-ratio: 1;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        cursor: pointer;
        color: #64748b;
        text-decoration: none !important;
        background: #fff;
    }

        .day-item.filled {
            background-color: #dcfce7 !important;
            color: #15803d !important;
        }

        .day-item.active {
            border: 3px solid #4361ee !important;
            transform: scale(1.05);
        }

    /* A4 BELGE STANDARTI */
    .official-document {
        width: 210mm;
        background: white;
        padding: 20mm;
        position: relative;
        box-sizing: border-box;
    }

    .document-content {
        min-height: 297mm;
        box-shadow: 0 0 30px rgba(0,0,0,0.1);
        border-radius: 4px;
        border: 1px solid #e2e8f0;
    }

    .official-table {
        width: 100%;
        border-collapse: collapse;
        border: 1.5px solid #000;
        margin-top: 20px;
        table-layout: fixed;
    }

        .official-table td {
            border: 1.5px solid #000;
            padding: 10px;
            font-family: 'Times New Roman', serif;
            color: #000;
            font-size: 11pt;
            word-wrap: break-word;
            text-align: left;
        }

            .official-table td:first-child {
                width: 40%;
                font-weight: 900;
                background: #fafafa;
            }

    .signature-grid {
        display: flex;
        justify-content: space-between;
        margin-top: 50px;
        text-align: center;
    }

    .sig-box {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 35px;
        font-family: 'Times New Roman', serif;
        font-size: 11pt;
        font-weight: bold;
    }

    /* 🖨️ PDF YAZDIRMA AYARLARI */
    #print-area {
        display: none;
    }

    @@page {
        size: A4;
        margin: 0 !important;
    }

    @@media print {
        header, nav, .navbar, .staj-nav-top, .staj-sidebar, .document-content, .no-print, button, .final-approval-card {
            display: none !important;
        }

        #print-area {
            display: block !important;
            width: 100% !important;
            background: white !important;
        }

        .print-page {
            width: 210mm;
            height: 296mm;
            padding: 20mm;
            page-break-after: always !important;
            background: white !important;
            color: black !important;
            display: block !important;
            position: relative;
        }

        .official-table td {
            color: black !important;
            background: white !important;
            border: 1.5px solid black !important;
        }
    }
</style>

<div class="staj-workspace">
    @* --- ÜST MENÜ --- *@
    <div class="staj-nav-top no-print">
        <button class="nav-btn active" id="btn-tab-kapak" onclick="switchTab('kapak')">📙 Dosya Kapağı</button>
        <button class="nav-btn inactive" id="btn-tab-raporlar" onclick="switchTab('raporlar')">📝 Günlük Raporlar</button>
    </div>

    @* --- 🛡️ DANIŞMAN FİNAL ONAY KARTI --- *@
    @if (isAdvisor)
    {
        <div class="container mb-4 no-print animate__animated animate__slideInDown final-approval-card" style="max-width: 1100px;">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body p-0">
                    <div class="row g-0">
                        <div class="col-md-8 p-4 @(ViewBag.CanApproveInternship == true ? "bg-success-subtle" : "bg-warning-subtle")">
                            <h5 class="fw-bold mb-1">
                                <i class="fas @(ViewBag.CanApproveInternship == true ? "fa-unlock-alt text-success" : "fa-lock text-warning") me-2"></i>
                                Staj Defteri Final Onay Denetimi
                            </h5>
                            <p class="text-muted small mb-0">Resmi mühürleme için 30 onaylı rapor gereklidir. <span class="badge bg-dark text-white ms-2">Mevcut: @(ViewBag.ApprovedReportsCount ?? 0) / 30</span></p>
                        </div>
                        <div class="col-md-4 d-flex align-items-center justify-content-center p-3 bg-white border-start">
                            @if (ViewBag.CanApproveInternship == true)
                            {
                                <form asp-controller="Advisor" asp-action="ApproveFullInternship" method="post" class="w-100 px-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="studentId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-success w-100 rounded-pill py-2 fw-bold shadow-sm">STAJI LİYAKATLE TAMAMLA</button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100 rounded-pill py-2 fw-bold opacity-75" disabled>SÜREÇ DEVAM EDİYOR</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="staj-main-container no-print">
        <div class="staj-sidebar" id="sidebarSelector" style="display:none;">
            <div class="card border-0 rounded-4 shadow-sm p-4">
                <h6 class="fw-bold text-primary text-center mb-3">İŞ GÜNÜ SEÇİMİ</h6>
                <div class="day-grid">
                    @for (int i = 1; i <= totalDays; i++)
                    {
                        var isFilled = reports.Any(r => r.DayNumber == i);
                        <a href="javascript:void(0)" onclick="loadDay(@i)" id="btn-day-@i" class="day-item @(isFilled ? "filled" : "")">@i</a>
                    }
                </div>
                @if (isAdvisor)
                {
                    <div class="mt-4 pt-3 border-top"><button class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow-sm" onclick="window.print()">PDF OLARAK İNDİR</button></div>
                }
            </div>
        </div>

        @* --- 🛡️ EKRAN ÖNİZLEME --- *@
        <div class="document-content official-document animate__animated animate__fadeIn">
            <div id="kapak-view">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                    <div style="width:80px"></div>
                    <div style="text-align:center; flex:1;">
                        <h5 style="margin:0; font-weight:bold;">T.C.</h5>
                        <h4 style="margin:0; font-weight:bold; text-transform:uppercase;">@(Model?.UniversityName ?? "ÜNİVERSİTE BELİRTİLMEMİŞ")</h4>
                        <div style="font-weight:bold; font-size:10pt;">@birimAdi</div>
                    </div>
                    <div style="text-align:right;">
                        <img src="@logoPath" style="width:80px; height:80px; object-fit:contain;" onerror="this.src='/img/logos/default.png';" />
                    </div>
                </div>

                <h1 style="text-align:center; font-family:'Times New Roman'; font-weight:900; border-top:4px solid #000; border-bottom:4px solid #000; padding:15px 0; letter-spacing:5px; margin: 30px 0; font-size: 22pt;">STAJ DEFTERİ</h1>

                <table class="official-table">
                    <tr><td>ÖĞRENCİ ADI SOYADI</td><td style="font-weight:bold; text-transform:uppercase;">@Model.Name @Model.Surname</td></tr>
                    <tr><td>ÖĞRENCİ NUMARASI</td><td>@Model.StudentNo</td></tr>
                    <tr><td>BÖLÜMÜ / PROGRAMI</td><td>@Model.DepartmentName</td></tr>
                    <tr><td>AKADEMİK YIL / SINIF</td><td>@Model.AcademicYear</td></tr>
                    <tr><td>STAJ YAPILAN KURUM</td><td>@(activeApp?.Internship?.CompanyName ?? "---")</td></tr>
                    <tr><td>STAJ KONUSU</td><td>Bilişim Teknolojileri ve Yazılım Geliştirme</td></tr>
                    <tr><td>İŞYERİ STAJ SORUMLUSU</td><td>Mühendis / Yönetici Adı Soyadı</td></tr>
                    <tr><td>STAJ TARİH ARALIĞI</td><td><strong>Başlangıç:</strong> @(activeApp?.Internship?.StartDate.ToString("dd.MM.yyyy") ?? "---") | <strong>Bitiş:</strong> @(activeApp?.Internship?.EndDate.ToString("dd.MM.yyyy") ?? "---")</td></tr>
                    <tr><td>TOPLAM İŞ GÜNÜ</td><td>@totalDays İŞ GÜNÜ</td></tr>
                </table>

                <div class="signature-grid">
                    <div class="sig-box"><span>Öğrenci</span><span>İmza</span></div>
                    <div class="sig-box"><span>Kurum Sorumlusu</span><span>Kaşe / İmza</span></div>
                    <div class="sig-box"><span>Bölüm Danışmanı</span><span>Onay</span></div>
                </div>
            </div>

            <div id="raporlar-view" style="display:none;" class="no-print">
                <h3 class="fw-bold mb-4 text-dark border-bottom pb-2"><span id="display-day-number" class="text-primary">1</span>. GÜN FAALİYETİ</h3>
                <form asp-controller="StudentPanel" asp-action="SaveDailyReport" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="dayNumber" id="input-day-number" value="1" />
                    <textarea name="content" id="report-content" class="form-control" style="min-height: 400px; font-family: 'Times New Roman';" @(isAdvisor ? "readonly" : "") placeholder="Teknik çalışmaları buraya mühürleyin..."></textarea>
                    <div class="text-center mt-3"><img id="display-report-image" src="" style="max-width:100%; display:none; border-radius:10px;" /></div>
                    @if (!isAdvisor)
                    {
                        <div class="mt-4 p-3 bg-white border rounded-4 d-flex justify-content-between align-items-center shadow-sm">
                            <input type="file" name="reportImage" id="imageInput" class="form-control form-control-sm border-0" onchange="önizleme(this)" />
                            <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold">KAYDET</button>
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>

    @* --- 🛡️ PDF YAZDIRMA KATMANI --- *@
    <div id="print-area">
        <div class="print-page">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                <div style="width:100px"></div>
                <div style="text-align:center; flex:1;">
                    <h5 style="margin:0; font-weight:bold;">T.C.</h5>
                    <h4 style="margin:0; font-weight:bold; text-transform:uppercase;">@Model.UniversityName</h4>
                    <p style="font-weight:bold; font-size:10pt; margin:0;">@birimAdi</p>
                </div>
                <div style="text-align:right;">
                    <img src="@logoPath" style="width:100px; height:100px; object-fit:contain;" onerror="this.src='/img/logos/default.png';" />
                </div>
            </div>
            <h1 style="text-align:center; font-family:'Times New Roman'; font-weight:900; border-top:4px solid #000; border-bottom:4px solid #000; padding:20px 0; letter-spacing:10px; margin: 40px 0;">STAJ DEFTERİ</h1>

            <table class="official-table">
                <tr><td>ÖĞRENCİ ADI SOYADI</td><td style="text-transform:uppercase; font-weight:bold;">@Model.Name @Model.Surname</td></tr>
                <tr><td>ÖĞRENCİ NUMARASI</td><td>@Model.StudentNo</td></tr>
                <tr><td>BÖLÜMÜ / PROGRAMI</td><td>@Model.DepartmentName</td></tr>
                <tr><td>AKADEMİK YIL / SINIF</td><td>@Model.AcademicYear</td></tr>
                <tr><td>STAJ YAPILAN KURUM</td><td>@(activeApp?.Internship?.CompanyName ?? "---")</td></tr>
                <tr><td>STAJ KONUSU</td><td>Bilişim Teknolojileri ve Yazılım Geliştirme</td></tr>
                <tr><td>İŞYERİ STAJ SORUMLUSU</td><td>Mühendis / Yönetici Adı Soyadı</td></tr>
                <tr><td>STAJ TARİH ARALIĞI</td><td>@(activeApp?.Internship?.StartDate.ToString("dd.MM.yyyy") ?? "---") - @(activeApp?.Internship?.EndDate.ToString("dd.MM.yyyy") ?? "---")</td></tr>
                <tr><td>TOPLAM İŞ GÜNÜ</td><td>@totalDays İŞ GÜNÜ</td></tr>
            </table>

            <div style="margin-top:80px; width: 100%;">
                <table style="width: 100%; border: none; text-align: center;">
                    <tr>
                        <td style="width: 33%; border:none;"><strong>Öğrenci</strong><br>(İmza)</td>
                        <td style="width: 33%; border:none;"><strong>Kurum Sorumlusu</strong><br>(Kaşe / İmza)</td>
                        <td style="width: 33%; border:none;"><strong>Bölüm Danışmanı</strong><br>(Onay)</td>
                    </tr>
                </table>
            </div>
        </div>

        @for (int i = 1; i <= totalDays; i++)
        {
            var r = reports.FirstOrDefault(x => x.DayNumber == i);
            <div class="print-page">
                <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #000; padding-bottom:5px; margin-bottom:15px;">
                    <h5 style="margin:0;">@(Model?.UniversityName?.ToUpper())</h5>
                    <span style="font-size:10pt; font-weight:bold;">@i. GÜN FAALİYET RAPORU</span>
                </div>
                <p><strong>Tarih:</strong> @(r != null ? r.CreatedDate.ToString("dd.MM.yyyy") : "---")</p>
                <div style="border: 1.5px solid #000; padding: 20px; min-height: 450px; font-family: 'Times New Roman'; font-size:12pt;">@(r?.Content ?? "Bu gün için rapor girişi yapılmamıştır.")</div>
                @if (r != null && !string.IsNullOrEmpty(r.ImagePath))
                {
                    <div style="text-align:center; margin-top:20px;"><img src="@(r.ImagePath.StartsWith("/") ? r.ImagePath : "/" + r.ImagePath)" style="max-height: 380px; max-width: 100%;" /></div>
                }
                <div style="position:absolute; bottom:15mm; left:20mm; right:20mm;">
                    <table style="width: 100%; border-top: 1.5px solid #000; text-align: center;">
                        <tr>
                            <td style="width: 33%; padding-top: 10px; border:none;"><strong>Öğrenci</strong><br>İmza</td>
                            <td style="width: 33%; padding-top: 10px; border:none;"><strong>İşyeri Onay</strong><br>Mühür / İmza</td>
                            <td style="width: 33%; padding-top: 10px; border:none;"><strong>Danışman</strong><br>İmza</td>
                        </tr>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const rawReports = @Html.Raw(Json.Serialize(reports.Select(r => new { dayNumber = r.DayNumber, content = r.Content, createdDate = r.CreatedDate, imagePath = r.ImagePath })));
        function switchTab(tab) {
            if(tab === 'kapak') {
                $('#kapak-view').show(); $('#raporlar-view').hide(); $('#sidebarSelector').fadeOut();
                $('#btn-tab-kapak').addClass('active'); $('#btn-tab-raporlar').removeClass('active');
            } else {
                $('#kapak-view').hide(); $('#raporlar-view').show(); $('#sidebarSelector').fadeIn();
                $('#btn-tab-raporlar').addClass('active'); $('#btn-tab-kapak').removeClass('active');
            }
        }
        function önizleme(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) { $('#display-report-image').attr('src', e.target.result).show(); }
                reader.readAsDataURL(input.files[0]);
            }
        }
        function loadDay(day) {
            $(".day-item").removeClass("active"); $("#btn-day-" + day).addClass("active");
            $("#display-day-number").text(day); $("#input-day-number").val(day);
            const r = rawReports.find(x => parseInt(x.dayNumber) === parseInt(day));
            if (r) {
                $("#report-content").val(r.content || "");
                if (r.imagePath && r.imagePath.trim() !== "") {
                    let path = r.imagePath.startsWith('/') ? r.imagePath : '/' + r.imagePath;
                    $('#display-report-image').attr('src', path).show();
                } else { $('#display-report-image').hide(); }
            } else { $("#report-content").val(""); $('#display-report-image').hide(); }
        }
        $(document).ready(function() { switchTab('kapak'); loadDay(1); });
    </script>
}