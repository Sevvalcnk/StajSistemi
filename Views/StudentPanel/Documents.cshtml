@model StajSistemi.DTOs.StudentDto

@{
    Layout = "_Layout";
    var activeApp = ViewBag.ActiveInternship as StajSistemi.Models.InternshipApplication;
    var reports = ViewBag.DailyReports as List<StajSistemi.Models.DailyReport> ?? new List<StajSistemi.Models.DailyReport>();
    int totalDays = 30;
    bool isAdvisor = User.IsInRole("Advisor") || User.IsInRole("Admin");

    // 🛡️ 🚀 LOGO MOTORU (SİNOP ÜNİVERSİTESİ ÖZEL - KORUNDU)
    string uniNameRaw = Model?.UniversityName ?? "";
    string uniNameLower = uniNameRaw.ToLower();
    string logoFileName = "default";
    string[] iller = { "ankara", "antalya", "aydin", "bursa", "eskisehir", "istanbul", "izmir", "kastamonu", "kocaeli", "mugla", "ordu", "sakarya", "samsun", "sinop", "trabzon" };

    if (!uniNameLower.Contains("diğer") && !uniNameLower.Contains("diger"))
    {
        foreach (var il in iller)
        {
            if (uniNameLower.Contains(il) || (il == "aydin" && uniNameLower.Contains("aydın")) || (il == "eskisehir" && uniNameLower.Contains("eskişehir")) || (il == "mugla" && uniNameLower.Contains("muğla")))
            {
                logoFileName = il; break;
            }
        }
    }
    string logoPath = $"/img/logos/{logoFileName}.png";
    string displayUniName = (uniNameLower.Contains("diğer") || uniNameLower.Contains("diger")) ? "T.C. ÜNİVERSİTESİ" : uniNameRaw.ToUpper();
    string birimAdi = Model?.FacultyName?.ToUpper() ?? "BİRİM BELİRTİLMEMİŞ";
}

<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">

<style>
    /* 🛡️ 1. SİBER UI TASARIMI (BÜYÜTÜLMÜŞ VE MODERN) */
    body {
        background-color: #f3f6f9;
        font-family: 'Inter', sans-serif;
        overflow-x: hidden;
        transition: 0.3s;
    }

    html[data-theme="dark"] body {
        background-color: #0f172a !important;
    }

    /* 💊 OVAL NAVİGASYON (KAPSÜL GÖRÜNÜMÜ) */
    .staj-nav-top {
        display: inline-flex;
        background: #fff;
        padding: 6px;
        border-radius: 50px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.06);
        border: 1px solid #e2e8f0;
        margin-bottom: 30px;
    }

    html[data-theme="dark"] .staj-nav-top {
        background: #1e293b !important;
        border-color: #334155 !important;
    }

    .nav-btn {
        border: none;
        padding: 10px 35px;
        border-radius: 40px;
        font-weight: 700;
        color: #64748b;
        background: transparent;
        cursor: pointer;
        transition: all 0.4s;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
    }

        .nav-btn.active {
            background-color: #4361ee !important;
            color: white !important;
            box-shadow: 0 6px 20px rgba(67, 97, 238, 0.3);
        }

    html[data-theme="dark"] .nav-btn:not(.active) {
        color: #94a3b8;
    }

    /* 📄 BELGE ALANI */
    .official-document {
        background: white !important;
        color: black !important;
        width: 215mm;
        min-height: 297mm;
        padding: 15mm 20mm;
        position: relative;
        box-sizing: border-box;
        box-shadow: 0 0 50px rgba(0,0,0,0.15);
        border-radius: 12px;
        margin: 0 auto 50px auto;
    }

    html[data-theme="dark"] .official-document {
        background-color: #1e293b !important;
        border: 1px solid #334155 !important;
    }

        html[data-theme="dark"] .official-document * {
            color: #f1f5f9 !important;
        }

    /* 🔵 GÜN SEÇİMİ */
    .day-grid {
        display: grid !important;
        grid-template-columns: repeat(5, 1fr) !important;
        gap: 10px !important;
    }

    .day-item {
        aspect-ratio: 1;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        cursor: pointer;
        background: #fff;
        color: #64748b;
        text-decoration: none !important;
        transition: 0.3s;
    }

    html[data-theme="dark"] .day-item {
        background-color: #0f172a !important;
        border-color: #334155 !important;
        color: #94a3b8 !important;
    }

    .day-item.filled {
        background-color: #dcfce7 !important;
        color: #15803d !important;
        border-color: #bbf7d0 !important;
    }

    html[data-theme="dark"] .day-item.filled {
        color: #10b981 !important;
        border-color: #10b981 !important;
    }

    .day-item.active {
        border: 3px solid #4361ee !important;
        transform: scale(1.1);
        box-shadow: 0 0 15px rgba(67, 97, 238, 0.4);
    }

    /* 📄 RESMİ TABLO STİLİ */
    .official-table {
        width: 100%;
        border-collapse: collapse;
        border: 2px solid currentColor;
        margin-top: 20px;
    }

        .official-table td {
            border: 1.5px solid currentColor;
            padding: 12px;
            font-family: 'Times New Roman', serif;
            font-size: 11.5pt;
            text-align: left;
        }

            .official-table td:first-child {
                width: 40%;
                font-weight: bold;
                background: rgba(0,0,0,0.03);
            }

    /* 🌑 EDİTÖR KARARTMA */
    html[data-theme="dark"] .note-editor.note-frame {
        background-color: #1e293b !important;
        border-color: #334155 !important;
    }

    html[data-theme="dark"] .note-toolbar {
        background-color: #0f172a !important;
        border-bottom: 1px solid #334155 !important;
    }

    html[data-theme="dark"] .note-btn {
        background-color: #1e293b !important;
        color: white !important;
        border: 1px solid #334155 !important;
    }

    html[data-theme="dark"] .note-editable {
        background-color: #1e293b !important;
        color: white !important;
    }

    /* 🖨️ 2. PDF / PRINT AYARLARI */
    #print-area {
        display: none;
    }

    @@media print {
        @@page {
            size: A4;
            margin: 0;
        }

        header, nav, .navbar, .staj-nav-top, .staj-sidebar, .document-content, .no-print, button, .alert {
            display: none !important;
        }

        body, html {
            background: white !important;
            width: 100%;
            height: auto;
        }

        #print-area {
            display: block !important;
            width: 210mm;
            margin: 0 auto;
        }

        .print-page {
            display: block !important;
            width: 210mm;
            height: 295mm;
            padding: 15mm 20mm !important;
            page-break-after: always !important;
            background: white !important;
            color: black !important;
            position: relative;
            border: none;
        }

        .official-table, .official-table td {
            border: 1.5px solid black !important;
            color: black !important;
        }

        .print-page * {
            color: black !important;
            background-color: transparent !important;
        }

        .print-page img {
            max-width: 48% !important;
            display: inline-block !important;
            margin: 1% !important;
        }
    }

    .staj-workspace {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 15px;
        width: 100%;
        min-height: 100vh;
    }

    .staj-main-container {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 25px;
        width: 98%;
        max-width: 1700px;
    }

    .staj-sidebar {
        width: 300px;
        flex-shrink: 0;
    }

    .signature-grid {
        display: flex;
        justify-content: space-between;
        margin-top: 60px;
        text-align: center;
    }

    .sig-box {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 30px;
        font-family: 'Times New Roman', serif;
        font-size: 11pt;
        font-weight: bold;
    }

    .note-modal-backdrop {
        display: none !important;
    }

    .note-modal {
        z-index: 100050 !important;
        position: fixed !important;
        top: 10% !important;
    }
</style>

<div class="staj-workspace">
    <div class="staj-nav-top no-print">
        <button class="nav-btn active" id="btn-tab-kapak" onclick="switchTab('kapak')">📙 Dosya Kapağı</button>
        <button class="nav-btn" id="btn-tab-raporlar" onclick="switchTab('raporlar')">📝 Günlük Raporlar</button>
    </div>

    <div class="staj-main-container no-print">
        <div class="staj-sidebar" id="sidebarSelector" style="display:none;">
            <div class="card border-0 rounded-4 shadow-sm p-4">
                <h6 class="fw-bold text-primary text-center mb-3">İŞ GÜNÜ SEÇİMİ</h6>
                <div class="day-grid">
                    @for (int i = 1; i <= totalDays; i++)
                    {
                        var isFilled = reports.Any(r => r.DayNumber == i);
                        <a href="javascript:void(0)" onclick="loadDay(@i)" id="btn-day-@i" class="day-item @(isFilled ? "filled" : "")">@i</a>
                    }
                </div>
                @if (isAdvisor)
                {
                    <div class="mt-4 pt-3 border-top"><button class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow-sm" onclick="window.print()">PDF ÇIKTISI AL (32 Sayfa)</button></div>
                }
            </div>
        </div>

        <div class="document-content official-document animate__animated animate__fadeIn">
            <div id="kapak-view">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
                    <div style="width:80px"></div>
                    <div style="text-align:center; flex:1;">
                        <h5 style="margin:0; font-weight:bold;">T.C.</h5>
                        <h4 style="margin:0; font-weight:bold; text-transform:uppercase;">@displayUniName</h4>
                        <div style="font-weight:bold; font-size:10pt;">@birimAdi</div>
                    </div>
                    <div style="text-align:right;"><img src="@logoPath" style="width:90px; height:90px; object-fit:contain;" onerror="this.src='/img/logos/sinop.png';" /></div>
                </div>
                <h1 style="text-align:center; font-family:'Times New Roman'; font-weight:900; border-top:4px solid currentColor; border-bottom:4px solid currentColor; padding:15px 0; letter-spacing:5px; margin: 30px 0; font-size: 24pt;">STAJ DEFTERİ</h1>

                <table class="official-table">
                    <tr><td>ÖĞRENCİ ADI SOYADI</td><td style="text-transform:uppercase; font-weight:bold;">@Model.Name @Model.Surname</td></tr>
                    <tr><td>ÖĞRENCİ NUMARASI</td><td>@Model.StudentNo</td></tr>
                    <tr><td>BÖLÜMÜ / PROGRAMI</td><td>@Model.DepartmentName</td></tr>
                    <tr><td>AKADEMİK YIL / SINIF</td><td>@Model.AcademicYear / @(string.IsNullOrEmpty(Model.Grade) ? "---" : Model.Grade + ". SINIF")</td></tr>
                    <tr><td>STAJ YAPILAN KURUM</td><td>@(activeApp?.Internship?.CompanyName ?? "---")</td></tr>
                    <tr><td>STAJ KONUSU</td><td>@(activeApp?.Internship?.Name ?? "---")</td></tr>
                    <tr><td>İŞYERİ STAJ SORUMLUSU</td><td>@(ViewBag.SupervisorName ?? "---")</td></tr>
                    <tr><td>STAJ TARİH ARALIĞI</td><td>@(activeApp?.Internship?.StartDate.ToString("dd.MM.yyyy") ?? "---") - @(activeApp?.Internship?.EndDate.ToString("dd.MM.yyyy") ?? "---")</td></tr>
                    <tr><td>TOPLAM İŞ GÜNÜ</td><td>@totalDays İŞ GÜNÜ</td></tr>
                </table>

                <div class="signature-grid">
                    <div class="sig-box"><span>Öğrenci</span><span>İmza</span></div>
                    <div class="sig-box"><span>Kurum Sorumlusu</span><span>Kaşe / İmza</span></div>
                    <div class="sig-box"><span>Bölüm Danışmanı</span><span>Onay / İmza</span></div>
                </div>
            </div>

            <div id="raporlar-view" style="display:none;">
                <h3 class="fw-bold mb-4 text-primary"><span id="display-day-number">1</span>. GÜN FAALİYETİ</h3>
                <form asp-controller="StudentPanel" asp-action="SaveDailyReport" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="dayNumber" id="input-day-number" value="1" />
                    @if (isAdvisor)
                    {
                        <div id="advisor-readonly-content" class="p-4 border rounded-4 bg-white" style="min-height: 600px; overflow-y: auto;"></div>
                    }
                    else
                    {
                        <textarea name="content" id="report-content" class="form-control"></textarea>
                        <div class="mt-4 text-end"><button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-lg">KAYDET</button></div>
                    }
                </form>
            </div>
        </div>
    </div>

    <div id="print-area">
        <div class="print-page">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <div style="width:100px"></div>
                <div style="text-align:center; flex:1;">
                    <h5 style="margin:0; font-weight:bold;">T.C.</h5><h4 style="text-transform:uppercase;">@displayUniName</h4><p style="font-weight:bold; font-size:10pt;">@birimAdi</p>
                </div>
                <div style="text-align:right;"><img src="@logoPath" style="width:110px; height:110px; object-fit:contain;" onerror="this.src='/img/logos/sinop.png';" /></div>
            </div>
            <h1 style="text-align:center; font-family:'Times New Roman'; font-weight:900; border-top:4px solid #000; border-bottom:4px solid #000; padding:20px 0; letter-spacing:5px; margin: 30px 0;">STAJ DEFTERİ</h1>

            <table class="official-table">
                <tr><td>ÖĞRENCİ ADI SOYADI</td><td style="text-transform:uppercase; font-weight:bold;">@Model.Name @Model.Surname</td></tr>
                <tr><td>ÖĞRENCİ NUMARASI</td><td>@Model.StudentNo</td></tr>
                <tr><td>BÖLÜMÜ / PROGRAMI</td><td>@Model.DepartmentName</td></tr>
                <tr><td>AKADEMİK YIL / SINIF</td><td>@Model.AcademicYear / @(string.IsNullOrEmpty(Model.Grade) ? "Belirtilmemiş" : Model.Grade + ". SINIF")</td></tr>
                <tr><td>STAJ YAPILAN KURUM</td><td>@(activeApp?.Internship?.CompanyName ?? "---")</td></tr>
                <tr><td>STAJ KONUSU</td><td>@(activeApp?.Internship?.Name ?? "---")</td></tr>
                <tr><td>İŞYERİ STAJ SORUMLUSU</td><td>@(ViewBag.SupervisorName ?? "---")</td></tr>
                <tr><td>STAJ TARİH ARALIĞI</td><td>@(activeApp?.Internship?.StartDate.ToString("dd.MM.yyyy") ?? "---") - @(activeApp?.Internship?.EndDate.ToString("dd.MM.yyyy") ?? "---")</td></tr>
                <tr><td>TOPLAM İŞ GÜNÜ</td><td>@totalDays İŞ GÜNÜ</td></tr>
            </table>
            <div class="signature-grid" style="margin-top:80px; font-weight:bold; color:black !important;"><div style="flex:1">Öğrenci</div><div style="flex:1">Kurum Sorumlusu</div><div style="flex:1">Bölüm Danışmanı</div></div>
        </div>

        @for (int i = 1; i <= totalDays; i++)
        {
            var r = reports.FirstOrDefault(x => x.DayNumber == i);
            <div class="print-page">
                <div style="display:flex; justify-content:space-between; border-bottom:2px solid #000; padding-bottom:5px;">
                    <strong>@displayUniName</strong><strong>@i. GÜN FAALİYET RAPORU</strong>
                </div>
                <p style="margin-top:10px;"><strong>Tarih:</strong> @(r != null ? r.CreatedDate.ToString("dd.MM.yyyy") : "---")</p>
                <div style="border: 2px solid #000; padding: 20px; min-height: 190mm; font-family: 'Times New Roman'; font-size:12pt;">@Html.Raw(r?.Content ?? "Bu gün için rapor girişi yapılmamıştır.")</div>
                <div class="signature-grid" style="margin-top:20px; font-weight:bold; color:black !important;"><div style="flex:1">Öğrenci<br>İmza</div><div style="flex:1">Kurum Onay<br>Mühür / İmza</div><div style="flex:1">Danışman<br>Onay / İmza</div></div>
            </div>
        }
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>

    <script>
        const rawReports = @Html.Raw(Json.Serialize(reports.Select(r => new { dayNumber = r.DayNumber, content = r.Content })));

        $(document).ready(function () {
            if (!@(isAdvisor.ToString().ToLower())) {
                $('#report-content').summernote({
                    height: 500, dialogsInBody: true, dialogsFade: false,
                    placeholder: 'Raporunuzu yazın, görseller otomatik kolajlanır... 🖼️',
                    toolbar: [
                        ['style', ['style']], ['font', ['bold', 'underline', 'clear']],
                        ['para', ['ul', 'ol', 'paragraph']], ['insert', ['link', 'picture', 'video']], ['view', ['fullscreen', 'codeview']]
                    ],
                    callbacks: { onImageUpload: function(files) { for (let i = 0; i < files.length; i++) { uploadEditorImage(files[i]); } } }
                });
            }
            switchTab('kapak'); loadDay(1);
        });

        function uploadEditorImage(file) {
            let data = new FormData(); data.append("file", file);
            $.ajax({
                url: '/StudentPanel/UploadEditorImage', method: 'POST', data: data, processData: false, contentType: false,
                success: function(response) {
                    if(response.url) {
                        let currentCode = $('#report-content').summernote('code');
                        let imgHtml = `<img src="${response.url}" style="width:48%; margin:1%;">`;
                        $('#report-content').summernote('code', currentCode + imgHtml);
                        $('.note-modal').hide();
                    }
                }
            });
        }

        function loadDay(day) {
            $(".day-item").removeClass("active"); $("#btn-day-" + day).addClass("active");
            $("#display-day-number").text(day); $("#input-day-number").val(day);
            const r = rawReports.find(x => parseInt(x.dayNumber) === parseInt(day));
            if (r) {
                if (@(isAdvisor.ToString().ToLower())) { $('#advisor-readonly-content').html(r.content || "İçerik boş."); }
                else { $('#report-content').summernote('code', r.content || ""); }
            } else {
                if (!@(isAdvisor.ToString().ToLower())) $('#report-content').summernote('code', "");
                else $('#advisor-readonly-content').html("Rapor girişi yapılmamış.");
            }
        }

        function switchTab(tab) {
            if (tab === 'kapak') {
                $('#kapak-view').show(); $('#raporlar-view').hide(); $('#sidebarSelector').fadeOut();
                optionsAtEnd(tab);
            } else {
                $('#kapak-view').hide(); $('#raporlar-view').show(); $('#sidebarSelector').fadeIn();
                optionsAtEnd(tab);
            }
        }
        function optionsAtEnd(tab) {
            if (tab === 'kapak') {
                $('#btn-tab-kapak').addClass('active'); $('#btn-tab-raporlar').removeClass('active');
            } else {
                $('#btn-tab-raporlar').addClass('active'); $('#btn-tab-kapak').removeClass('active');
            }
        }
    </script>
}