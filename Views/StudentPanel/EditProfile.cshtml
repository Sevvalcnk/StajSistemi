@model StajSistemi.DTOs.StudentDto

@{
    ViewData["Title"] = "Profil Bilgilerini Güncelle";
}

<style>
    /* 🛡️ SENİN TÜM TASARIM KODLARIN (BOZULMADAN KORUNDU) */
    body {
        background-color: #f8faff;
        background-image: radial-gradient(at 0% 0%, rgba(37, 140, 251, 0.05) 0, transparent 50%), radial-gradient(at 100% 100%, rgba(118, 75, 162, 0.05) 0, transparent 50%), radial-gradient(#d1d8e0 0.5px, transparent 0.5px);
        background-size: 100% 100%, 100% 100%, 30px 30px;
        background-attachment: fixed;
    }

    .card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important;
    }

    [data-theme="dark"] .card {
        background-color: #1e293b !important;
        color: #f1f5f9 !important;
    }

    [data-theme="dark"] .card-body {
        background-color: #1e293b !important;
    }

    [data-theme="dark"] .bg-white {
        background-color: #1e293b !important;
    }

    [data-theme="dark"] .bg-light {
        background-color: #0f172a !important;
        color: #f1f5f9 !important;
    }

    [data-theme="dark"] .text-muted {
        color: #94a3b8 !important;
    }

    [data-theme="dark"] .form-control, [data-theme="dark"] .form-select {
        background-color: #0f172a !important;
        color: white !important;
        border-color: #334155 !important;
    }

    .input-focus:focus {
        border-color: #2c3e50 !important;
        box-shadow: 0 0 10px rgba(44, 62, 80, 0.1) !important;
    }

    .border-dashed {
        border-style: dashed !important;
    }
</style>

<div class="container py-5 techNode-fade-in">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-9">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white text-center py-4">
                    <h3 class="fw-bold mb-0"><i class="fas fa-user-edit me-2"></i>Kariyer Profilini Güncelle</h3>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="EditProfile" method="post" enctype="multipart/form-data" id="profileEditForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="StudentNo" />

                        <div class="mb-4 text-center">
                            <img src="https://ui-avatars.com/api/?name=@Model.Name+@Model.Surname&background=2c3e50&color=fff&size=100" class="rounded-circle shadow-sm mb-2" alt="Avatar">
                            <p class="text-muted small mb-0">@Model.Email</p>
                            <span class="badge bg-light text-dark border">No: @Model.StudentNo</span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-bold text-muted small text-uppercase">Adınız</label>
                                <input asp-for="Name" class="form-control rounded-pill border-2 input-focus" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Surname" class="form-label fw-bold text-muted small text-uppercase">Soyadınız</label>
                                <input asp-for="Surname" class="form-control rounded-pill border-2 input-focus" />
                                <span asp-validation-for="Surname" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="DegreeType" class="form-label fw-bold text-muted small text-uppercase">Eğitim Düzeyi</label>
                                <select asp-for="DegreeType" class="form-select rounded-pill border-2 input-focus" id="degreeSelect">
                                    <option value="">Seçiniz...</option>
                                    <option value="Lisans">Lisans</option>
                                    <option value="Önlisans">Önlisans</option>
                                </select>
                                <span asp-validation-for="DegreeType" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted small text-uppercase">Üniversite Seçiniz</label>
                                <select asp-for="UniversityName" class="form-select rounded-pill border-2 input-focus shadow-sm">
                                    <option value="">Seçiniz...</option>
                                    <option value="Sinop Üniversitesi">Sinop Üniversitesi</option>
                                    <option value="Ordu Üniversitesi">Ordu Üniversitesi</option>
                                    <option value="Samsun Ondokuz Mayıs Üniversitesi">Samsun Ondokuz Mayıs Üniversitesi</option>
                                    <option value="Ankara Üniversitesi">Ankara Üniversitesi</option>
                                    <option value="İstanbul Üniversitesi">İstanbul Üniversitesi</option>
                                    <option value="İzmir Ege Üniversitesi">İzmir Ege Üniversitesi</option>
                                    <option value="Aydın Üniversitesi">Aydın Üniversitesi</option>
                                    <option value="Bursa Uludağ Üniversitesi">Bursa Uludağ Üniversitesi</option>
                                    <option value="Eskişehir Üniversitesi">Eskişehir Üniversitesi</option>
                                    <option value="Kastamonu Üniversitesi">Kastamonu Üniversitesi</option>
                                    <option value="Kocaeli Üniversitesi">Kocaeli Üniversitesi</option>
                                    <option value="Muğla Üniversitesi">Muğla Üniversitesi</option>
                                    <option value="Sakarya Üniversitesi">Sakarya Üniversitesi</option>
                                    <option value="Antalya Akdeniz Üniversitesi">Antalya Akdeniz Üniversitesi</option>
                                    <option value="Trabzon Karadeniz Teknik Üniversitesi">Trabzon Karadeniz Teknik Üniversitesi</option>
                                    <option value="Diğer">Diğer (Listede Yok)</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label id="facultyLabel" class="form-label fw-bold text-muted small text-uppercase">
                                    @(Model.DegreeType == "Önlisans" ? "Meslek Yüksekokulu" : "Fakülte Adı")
                                </label>
                                <input asp-for="FacultyName" class="form-control rounded-pill border-2 input-focus" placeholder="Birim adı" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DepartmentId" class="form-label fw-bold text-muted small text-uppercase">Okuduğunuz Bölüm</label>
                                <select asp-for="DepartmentId" class="form-select rounded-pill border-2 input-focus" id="DepartmentSelect">
                                    <option value="">--- Eğitim Düzeyi Seçiniz ---</option>
                                </select>
                                <span asp-validation-for="DepartmentId" class="text-danger small fw-bold"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="CityId" class="form-label fw-bold text-muted small text-uppercase">Yaşadığınız Şehir</label>
                                <select asp-for="CityId" class="form-select rounded-pill border-2 input-focus" asp-items="ViewBag.Cities">
                                    <option value="">--- Şehir Seçiniz ---</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-bold text-muted small text-uppercase">Telefon</label>
                                <input asp-for="PhoneNumber" class="form-control rounded-pill border-2 input-focus" placeholder="05XX..." />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="BirthPlace" class="form-label fw-bold text-muted small text-uppercase">Doğum Yeri</label>
                                <input asp-for="BirthPlace" class="form-control rounded-pill border-2 input-focus" placeholder="Şehir" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="BirthDate" class="form-label fw-bold text-muted small text-uppercase">Doğum Tarihi</label>
                                <input asp-for="BirthDate" type="date" class="form-control rounded-pill border-2 input-focus" />
                            </div>
                        </div>

                        @* 🚀 SİBER GÜNCELLEME: Akademik Yıl ve Geri Getirilen Sınıf Alanı *@
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="AcademicYear" class="form-label fw-bold text-muted small text-uppercase">Akademik Yıl</label>
                                <input asp-for="AcademicYear" class="form-control rounded-pill border-2 input-focus" placeholder="2024-2026" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Grade" class="form-label fw-bold text-muted small text-uppercase">Sınıf / Kademe</label>
                                <select asp-for="Grade" class="form-select rounded-pill border-2 input-focus">
                                    <option value="">Seçiniz...</option>
                                    <option value="1">1. Sınıf</option>
                                    <option value="2">2. Sınıf</option>
                                    <option value="3">3. Sınıf</option>
                                    <option value="4">4. Sınıf</option>
                                    <option value="Mezun">Mezun</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label asp-for="GPA" class="form-label fw-bold text-muted small text-uppercase">GPA (Maks: 4.00)</label>
                                <input asp-for="GPA" type="number" step="0.01" min="0" max="4.00" class="form-control rounded-pill border-2 input-focus" placeholder="3.50" required id="GPAInput" />
                                <span asp-validation-for="GPA" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PersonalSkills" class="form-label fw-bold text-muted small text-uppercase">Yetenekler</label>
                            <textarea asp-for="PersonalSkills" class="form-control rounded-4 border-2 input-focus" rows="2" placeholder="Yazılım, Dil, Ofis Araçları..."></textarea>
                        </div>

                        <hr class="my-4">

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="p-3 border-2 border-dashed rounded-4 bg-light text-center h-100 shadow-sm">
                                    <i class="fas fa-file-pdf text-danger mb-2 fa-2x"></i>
                                    <label class="d-block fw-bold small text-uppercase mb-2">CV Yükle (PDF/Word)</label>
                                    <input type="file" name="CVFile" id="CVFile" class="form-control form-control-sm rounded-pill" accept=".pdf,.doc,.docx" onchange="validateFileType(this)" />
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="p-3 border-2 border-dashed rounded-4 bg-light text-center h-100 shadow-sm">
                                    <i class="fas fa-award text-warning mb-2 fa-2x"></i>
                                    <label class="d-block fw-bold small text-uppercase mb-2">Sertifikalar (PDF/PPT)</label>
                                    <input type="file" name="CertificateFile" id="CertificateFile" class="form-control form-control-sm rounded-pill" accept=".pdf,.doc,.docx,.ppt,.pptx" onchange="validateFileType(this)" />
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow">
                                <i class="fas fa-save me-2"></i>Değişiklikleri Mühürle
                            </button>
                            <a asp-action="Index" class="btn btn-link text-muted mt-2 text-decoration-none text-center">Vazgeç ve Geri Dön</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // 📸 DOSYA FORMATI KONTROLÜ
        function validateFileType(input) {
            const fileName = input.value;
            const allowedExtensions = /(\.pdf|\.doc|\.docx|\.ppt|\.pptx)$/i;
            if (fileName && !allowedExtensions.exec(fileName)) {
                Swal.fire({ title: 'Geçersiz Format!', text: 'Lütfen sadece PDF, Word veya PowerPoint dosyası seçiniz.', icon: 'warning', confirmButtonColor: '#2c3e50', confirmButtonText: 'Anladım' });
                input.value = ''; return false;
            }
            return true;
        }

        // 🛡️ 🚀 KRİTİK: BÖLÜMLERİ SEVİYEYE GÖRE FİLTRELEYEN SİBER MOTOR
        function loadFilteredDepartments(level) {
            const $deptSelect = $('#DepartmentSelect');
            if (!level) {
                $deptSelect.html('<option value="">--- Önce Eğitim Düzeyi Seçiniz ---</option>');
                return;
            }

            $deptSelect.html('<option value="">⏳ Bölümler dökülüyor...</option>');

            // Controller'daki yeni yazdığımız metoda gidiyoruz
            const url = '/StudentPanel/GetFilteredDepartments';
            const currentDeptId = "@(Model?.DepartmentId ?? 0)";

            $.ajax({
                url: url,
                type: 'GET',
                data: { level: level },
                dataType: 'json',
                success: function (data) {
                    $deptSelect.empty();
                    $deptSelect.append('<option value="">--- Bölümünüzü Seçiniz ---</option>');
                    if (Array.isArray(data) && data.length > 0) {
                        $.each(data, function (index, item) {
                            const itemId = item.id || item.Id;
                            const itemName = item.name || item.DepartmentName;
                            const isSelected = (itemId.toString() === currentDeptId.toString()) ? ' selected' : '';
                            $deptSelect.append('<option value="' + itemId + '"' + isSelected + '>' + itemName + '</option>');
                        });
                    } else { $deptSelect.append('<option value="">⚠️ Bölüm bulunamadı!</option>'); }
                },
                error: function () { $deptSelect.html('<option value="">❌ Bağlantı Hatası!</option>'); }
            });
        }

        $(document).ready(function() {
            // Sayfa açıldığında mevcut seviyeye göre bölümleri yükle
            const initialLevel = $('#degreeSelect').val();
            if(initialLevel) { loadFilteredDepartments(initialLevel); }

            // 🚀 EĞİTİM DÜZEYİ DEĞİŞTİĞİNDE TETİKLENİR
            $('#degreeSelect').on('change', function() {
                const val = $(this).val();

                // 1. Etiketi Değiştir (Senin mevcut kodun)
                const label = document.getElementById('facultyLabel');
                if(label) { label.innerText = (val === "Önlisans") ? "Meslek Yüksekokulu" : "Fakülte Adı"; }

                // 2. Bölüm Listesini Filtrele (Yeni Siber Mantık)
                loadFilteredDepartments(val);
            });
        });

        // 🛡️ FORM GÖNDERME KONTROLÜ
        document.getElementById('profileEditForm').onsubmit = function (e) {
            const gpaInput = document.getElementById('GPAInput');
            const deptSelect = document.getElementById('DepartmentSelect');
            if (!deptSelect.value || deptSelect.value === "" || deptSelect.value.includes("---")) {
                Swal.fire({ title: 'Eksik Bilgi!', text: 'Lütfen bölümünüzü seçiniz.', icon: 'error' });
                e.preventDefault(); return false;
            }
            if (gpaInput.value && parseFloat(gpaInput.value.replace(',', '.')) > 4.00) {
                Swal.fire({ title: 'Hatalı GPA!', text: 'GPA 4.00\'den büyük olamaz!', icon: 'error' });
                e.preventDefault(); return false;
            }
            return true;
        };
    </script>
}