@model StajSistemi.DTOs.StudentDto
@{
    ViewData["Title"] = "Staj Dashboard";
    var appliedIds = ViewBag.AppliedInternshipIds as List<int> ?? new List<int>();
    var timelineApp = ViewBag.ActiveAppForTimeline as StajSistemi.Models.InternshipApplication;
    var approvedCounts = ViewBag.ApprovedCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    bool isAdvisor = User.IsInRole("Advisor") || User.IsInRole("Admin");

    // 🛡️ SİBER HESAPLAMA: Artık "onaylı" değil, "toplam yazılan" raporları sayıyoruz (0/30 sorunu çözüldü)
    int totalWrittenReports = ViewBag.TotalReportsCount ?? 0;
    double currentProgress = ((double)totalWrittenReports / 30) * 100;
    if (currentProgress > 100) currentProgress = 100;

    int stepLevel = 0;
    if (timelineApp != null)
    {
        stepLevel = 1;
        if (timelineApp.Status == StajSistemi.Models.ApplicationStatus.Approved) stepLevel = 2;
        if (timelineApp.Status == StajSistemi.Models.ApplicationStatus.Approved && timelineApp.Internship != null && DateTime.Now >= timelineApp.Internship.StartDate) stepLevel = 3;
        if (timelineApp.Status == StajSistemi.Models.ApplicationStatus.Approved && timelineApp.Internship != null && DateTime.Now > timelineApp.Internship.EndDate) stepLevel = 4;
    }
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    body {
        background-color: #f3f6f9;
        font-family: 'Inter', sans-serif;
        transition: all 0.3s ease;
    }

    [data-theme="dark"] body {
        background-color: #0f172a !important;
    }

    [data-theme="dark"] .t-date {
        background: rgba(67, 97, 238, 0.1) !important;
        color: #4361ee !important;
        border: 1px solid rgba(67, 97, 238, 0.2) !important;
    }

    [data-theme="dark"] .staj-row td {
        background: #1e293b !important;
        border-color: rgba(255, 255, 255, 0.05) !important;
    }

    [data-theme="dark"] .badge-program {
        background: #334155 !important;
        color: #bae6fd !important;
        border-color: #475569 !important;
    }

    [data-theme="dark"] .quota-badge {
        background: #0f172a !important;
        color: #f1f5f9 !important;
        border-color: #334155 !important;
    }

    [data-theme="dark"] .profile-card, [data-theme="dark"] .kokpit-card, [data-theme="dark"] .timeline-wrapper, [data-theme="dark"] .staj-list-card, [data-theme="dark"] .bg-white {
        background-color: #1e293b !important;
        color: #f1f5f9 !important;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3) !important;
        border: none !important;
    }

    [data-theme="dark"] .text-dark, [data-theme="dark"] .fw-bold, [data-theme="dark"] h5, [data-theme="dark"] h6, [data-theme="dark"] p {
        color: #f1f5f9 !important;
    }

    [data-theme="dark"] .text-muted {
        color: #94a3b8 !important;
    }

    .quota-badge {
        font-weight: 800;
        font-size: 0.85rem;
        padding: 8px 15px;
        border-radius: 50px;
        white-space: nowrap !important;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        min-width: 75px;
        text-align: center;
    }

    .centered-container {
        max-width: 1250px;
        margin: 0 auto;
        padding: 30px 15px;
    }

    .profile-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        padding: 25px;
        text-align: center;
        border: none;
    }

    .profile-img {
        width: 100px;
        height: 100px;
        border-radius: 30px;
        border: 4px solid white;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        object-fit: cover;
    }

    .kokpit-card {
        background: white;
        border-radius: 20px;
        padding: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        border: none;
        transition: 0.3s;
    }

        .kokpit-card:hover {
            transform: translateY(-5px);
        }

    .cyber-progress {
        height: 16px;
        background-color: rgba(0,0,0,0.1);
        border-radius: 50px;
        overflow: hidden;
    }

    .cyber-progress-bar {
        background: linear-gradient(90deg, #10b981, #34d399) !important;
        box-shadow: 0 0 15px rgba(16, 185, 129, 0.4) !important;
        transition: 1.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .stat-icon {
        width: 45px;
        height: 45px;
        line-height: 45px;
        text-align: center;
        border-radius: 12px;
        font-size: 1.2rem;
        margin-bottom: 15px;
    }

    .timeline-wrapper {
        background: white;
        border-radius: 20px;
        padding: 40px 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    .timeline-steps {
        display: flex;
        justify-content: space-between;
        position: relative;
    }

    .timeline-line {
        position: absolute;
        top: 25px;
        left: 5%;
        right: 5%;
        height: 4px;
        background: #e2e8f0;
        z-index: 1;
    }

    .timeline-line-active {
        position: absolute;
        top: 25px;
        left: 5%;
        height: 4px;
        background: #4361ee;
        z-index: 2;
        transition: 1s ease;
        width: @(stepLevel <= 1 ? 0 : (stepLevel == 2 ? 33 : (stepLevel == 3 ? 66 : 90))) %;
    }

    .t-step {
        text-align: center;
        position: relative;
        z-index: 3;
        flex: 1;
    }

    .t-icon {
        width: 50px;
        height: 50px;
        line-height: 50px;
        border-radius: 50%;
        background: white;
        border: 4px solid #e2e8f0;
        display: inline-block;
        transition: 0.3s;
        color: #94a3b8;
    }

    .t-step.completed .t-icon {
        background: #4361ee;
        border-color: #4361ee;
        color: white;
    }

    .t-step.finish .t-icon {
        background: #10b981;
        border-color: #10b981;
        color: white;
    }

    .t-label {
        font-weight: 800;
        margin-top: 15px;
        font-size: 0.8rem;
        text-transform: uppercase;
    }

    .t-date {
        font-weight: 700;
        font-size: 0.7rem;
        color: #4361ee;
        margin-top: 5px;
        background: #f0f3ff;
        padding: 2px 8px;
        border-radius: 6px;
    }

    .staj-list-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        padding: 25px;
        border: none;
    }

    .staj-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px;
    }

    .staj-row td {
        padding: 18px 15px;
        vertical-align: middle;
        background: #ffffff;
    }

    .badge-program {
        background: #e0f2fe;
        color: #0369a1;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 700;
        border: 1px solid #bae6fd;
        display: inline-block;
        margin: 2px;
    }
</style>

<div class="centered-container">
    <div class="row g-4">
        <div class="col-12 col-lg-4 col-xl-3">
            <div class="profile-card sticky-top" style="top: 20px;">
                <img src="https://ui-avatars.com/api/?name=@(Model.Name)+@(Model.Surname)&background=4361ee&color=fff" class="profile-img mb-3">
                <h5 class="fw-bold mb-1">@Model.Name @Model.Surname</h5>
                <p class="text-muted small">@Model.Email</p>
                <div class="text-start mt-3">
                    <label class="text-muted small fw-bold">Program/Bölüm</label>
                    <p class="fw-bold text-primary">@Model.DepartmentName</p>
                </div>
                <a asp-action="EditProfile" class="btn btn-outline-primary w-100 rounded-pill mt-3 py-2 btn-sm fw-bold shadow-sm">
                    <i class="fas fa-user-edit me-1"></i> Profili Güncelle
                </a>
            </div>
        </div>

        <div class="col-12 col-lg-8 col-xl-9">
            @* 🛡️ 🚀 AKILLI ASİSTAN NOTU BURADAN KALDIRILDI *@

            <div class="row g-3 mb-4 animate__animated animate__fadeIn">
                <div class="col-md-8">
                    <div class="kokpit-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0">Staj İlerleme Durumu</h6>
                            <span class="badge @(currentProgress >= 100 ? "bg-success text-white" : "bg-primary text-white") rounded-pill shadow-sm px-3">
                                %@currentProgress.ToString("0") Tamamlandı
                            </span>
                        </div>
                        <div class="cyber-progress mb-3">
                            <div class="progress-bar cyber-progress-bar progress-bar-striped progress-bar-animated"
                                 role="progressbar"
                                 style="width: @(currentProgress.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%; height: 100%;">
                            </div>
                        </div>
                        <p class="small text-muted mb-0">30 iş günü üzerinden mühürlenen rapor gelişim grafiği.</p>
                    </div>
                </div>
                <div class="col-md-4 text-center">
                    <div class="kokpit-card h-100">
                        <div class="stat-icon bg-success-subtle text-success mx-auto"><i class="fas fa-pen-nib"></i></div>
                        <h4 class="fw-bold mb-1">@totalWrittenReports</h4>
                        <p class="small text-muted mb-0">Yazılan Rapor Sayısı</p>
                    </div>
                </div>
            </div>

            <div class="timeline-wrapper mb-4">
                <h6 class="fw-bold text-muted small mb-4 text-center text-uppercase">Staj Süreci Operasyonel Takibi</h6>
                <div class="timeline-steps">
                    <div class="timeline-line"></div>
                    <div class="timeline-line-active"></div>
                    <div class="t-step @(stepLevel >= 1 ? "completed" : "")">
                        <div class="t-icon"><i class="fas fa-file-signature"></i></div>
                        <div class="t-label">BAŞVURU</div>
                        <div class="t-date">@(timelineApp != null ? timelineApp.ApplicationDate.ToString("dd.MM.yyyy") : "---")</div>
                    </div>
                    <div class="t-step @(stepLevel >= 2 ? "completed" : "")">
                        <div class="t-icon"><i class="fas fa-user-check"></i></div>
                        <div class="t-label">ONAY</div>
                        <div class="t-date">
                            @if (timelineApp != null && timelineApp.Status == StajSistemi.Models.ApplicationStatus.Approved)
                            {
                                @timelineApp.ApplicationDate.AddDays(1).ToString("dd.MM.yyyy")
                            }
                            else
                            {
                                <text>BEKLEMEDE</text>
                            }
                        </div>
                    </div>
                    <div class="t-step @(stepLevel >= 3 ? "completed" : "")">
                        <div class="t-icon"><i class="fas fa-play-circle"></i></div>
                        <div class="t-label">STAJ</div>
                        <div class="t-date">@(timelineApp?.Internship != null ? timelineApp.Internship.StartDate.ToString("dd.MM.yyyy") : "---")</div>
                    </div>
                    <div class="t-step @(stepLevel >= 4 ? "finish" : "")">
                        <div class="t-icon"><i class="fas fa-flag-checkered"></i></div>
                        <div class="t-label">BİTİŞ</div>
                        <div class="t-date">@(timelineApp?.Internship != null ? timelineApp.Internship.EndDate.ToString("dd.MM.yyyy") : "---")</div>
                    </div>
                </div>
            </div>

            @if (ViewBag.SmartMatches != null)
            {
                <div class="staj-list-card mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0"><i class="fas fa-list text-primary me-2"></i>Aktif İlanlar</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="staj-table">
                            <tbody>
                                @foreach (var match in (IEnumerable<StajSistemi.Models.Internship>)ViewBag.SmartMatches)
                                {
                                    int approved = approvedCounts.ContainsKey(match.Id) ? approvedCounts[match.Id] : 0;
                                    bool isFull = approved >= match.Quota;
                                    bool alreadyApplied = appliedIds.Contains(match.Id);

                                    <tr class="staj-row">
                                        <td>
                                            <div class="fw-bold">@match.CompanyName</div>
                                            <small class="text-muted">@match.City?.Name</small>
                                            @if (match.MatchScore > 0)
                                            {
                                                <div class="progress mt-2" style="height: 6px; border-radius: 10px; background-color: rgba(0,0,0,0.05); width: 130px;">
                                                    <div class="progress-bar progress-bar-striped progress-bar-animated @(match.MatchScore >= 70 ? "bg-success" : match.MatchScore >= 50 ? "bg-primary" : "bg-warning")"
                                                         role="progressbar" style="width: @match.MatchScore%;"></div>
                                                </div>
                                                <div class="text-primary fw-bold mt-1" style="font-size: 0.65rem;">%@match.MatchScore Uyumluluk</div>
                                            }
                                        </td>
                                        <td>
                                            @if (match.InternshipDepartments != null)
                                            {
                                                foreach (var deptMap in match.InternshipDepartments)
                                                {
                                                    <span class="badge-program">@(deptMap.Department?.DepartmentName ?? "Bölüm")</span>
                                                }
                                            }
                                        </td>
                                        <td class="text-center"><span class="quota-badge border">@approved / @match.Quota</span></td>
                                        <td class="text-center">
                                            @if (isFull)
                                            {
                                                <button class="btn btn-sm btn-secondary rounded-pill px-4 disabled">DOLU</button>
                                            }
                                            else if (alreadyApplied)
                                            {
                                                <button class="btn btn-sm btn-success rounded-pill px-4 disabled"><i class="fas fa-check me-1"></i>BAŞVURULDU</button>
                                            }
                                            else
                                            {
                                                <a asp-action="Apply" asp-route-id="@match.Id" class="btn btn-sm btn-primary rounded-pill px-4 shadow-sm fw-bold">Başvur</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @* 🛡️ 🚀 DANIŞMAN FİNAL KARAR PANELİ (REDDET BUTONU EKLENDİ) *@
            @if (isAdvisor)
            {
                <div class="mt-5 mb-5 p-4 border border-4 border-dashed rounded-4 bg-white shadow-lg text-center mx-auto"
                     style="max-width: 900px; border-color: @(totalWrittenReports >= 30 ? "#10b981" : "#e2e8f0");">

                    @if (totalWrittenReports >= 30)
                    {
                        <div class="py-3">
                            <i class="fas fa-gavel text-success fa-4x mb-3 animate__animated animate__bounceIn"></i>
                            <h3 class="fw-bold">STAJ DEFTERİ KARAR MERKEZİ</h3>
                            <p class="text-muted fs-5">Öğrenci 30 günlük rapor girişini tamamladı. Kararınızı mühürleyin.</p>

                            <div class="d-flex gap-3 justify-content-center mt-4">
                                @* ✅ ONAYLA *@
                                <form asp-controller="Advisor" asp-action="ApproveFullInternship" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="studentId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 fw-bold shadow-lg animate__animated animate__pulse animate__infinite">STAJI ONAYLA</button>
                                </form>

                                @* ❌ REDDET *@
                                <form asp-controller="Advisor" asp-action="RejectFullInternship" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="studentId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-danger btn-lg rounded-pill px-5 fw-bold shadow-lg" onclick="return confirm('Tüm staj sürecini reddetmek istediğinize emin misiniz?')">REDDET</button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted py-3">
                            <i class="fas fa-lock fa-3x mb-3 opacity-50"></i>
                            <h5 class="fw-bold">FİNAL KARAR KİLİTLİ</h5>
                            <p class="small mb-0">30 rapor tamamlanması bekleniyor. (Şu an: @totalWrittenReports / 30 GÜN)</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        @if (TempData["DeptMismatch"] != null)
        {
            <text>Swal.fire({ title: 'Bölüm Uygunluk Bildirimi', text: 'Seçtiğiniz ilan akademik kriterlerinizle tam örtüşmeyebilir.', icon: 'info', confirmButtonColor: '#4361ee' });</text>
        }
    </script>
}